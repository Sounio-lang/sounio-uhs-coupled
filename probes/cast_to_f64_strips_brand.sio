unit molal = mol / kg;

fn takes_molal(y: molal) -> f64 with Mut {
    y
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let m: molal = 2.0
    let stripped = m as f64
    let bad = takes_molal(stripped)
    return 0
}
