// Calcite dissolution rate — Palandri & Kharaka, USGS OFR 2004-1068, Table 33.
//
// This is the H1a mechanism: if calcite-derived CO2 limits methanogenesis, this
// is the term that sets how fast that carbon becomes available.
//
// Rate law, as the report gives it (eqn. 10 for a single mechanism, summed over
// the three, times the Lasaga chemical-affinity factor):
//
//   rate = SUM_i k_i(T) * a_j^n_i * (1 - Omega^p)^q          [mol m^-2 s^-1]
//   k_i(T) = k_i(25C) * exp( -Ea_i/R * (1/T - 1/298.15) )
//   Omega  = Q/K, the saturation ratio
//
// Table 33 tabulates log10 k at 25 C, pH 0, in mol m^-2 s^-1, with Ea in
// kJ/mol -- so the tabulated constant is k25 and the Arrhenius factor above is
// the conversion from it, not a second exponential.
//
// CALCITE HAS THREE MECHANISMS AND THE THIRD IS NOT THE BASE MECHANISM.
// For every other mineral class in that report the columns are acid / neutral /
// base and the third reaction order is with respect to H+ (footnote c). For
// carbonates the third column is the CARBONATE mechanism and its order is with
// respect to P(CO2) -- footnote d, a different footnote. A port that reused the
// base-mechanism form here would be wrong in the variable, not just the number.
//
// That is also where H1a lives: the rate law couples calcite to CO2 directly,
// not only through the carbonate equilibria.
//
// NEGATIVE CONSTANTS ARE `var`, NEVER MODULE-LEVEL `let`. A module-level `let`
// of type f64 holding a negative value is silently wrong on this compiler --
// `0.0 - 1.25` yields 0.0 and `-1.25` yields +1.25. See LANGUAGE_GAPS.md G9.
// Every log10 k below is negative, so every one of them would have been wrong.

unit mol_per_m2_s = mol / s;   // per unit area; area carried separately
unit kJ_per_mol   = kJ / mol;

// ── Table 33, calcite row, verbatim ────────────────────────────────────────
var LOG_K25_ACID: f64 = 0.0 - 0.30
var LOG_K25_NEUT: f64 = 0.0 - 5.81
var LOG_K25_CARB: f64 = 0.0 - 3.48

var EA_ACID_KJ: f64 = 14.4
var EA_NEUT_KJ: f64 = 23.5
var EA_CARB_KJ: f64 = 35.4

var N_ACID: f64 = 1.000        // order in a(H+)      -- footnote c
var N_CARB: f64 = 1.000        // order in P(CO2)     -- footnote d, NOT H+

var R_GAS: f64 = 8.31446261815324      // J mol^-1 K^-1
var T_REF_K: f64 = 298.15

// Chemical affinity exponents. Table 33 does not give them for calcite, and
// footnote e of the report says they "default to unity if not specified".
//
// The report does not treat that default as harmless. It says the values "are
// assumed to be equal to unity, which is likely incorrect", and that
// "uncertainties in values for p_i and q_i are currently the source of much
// uncertainty in the length of time computed in models of water-rock
// interaction". The nearest carbonate with MEASURED values is magnesite, at
// p = 4.00 -- a fourfold departure from the default.
//
// So these are carried as UNCERTAIN PARAMETERS with a stated default, not as
// constants, and the sensitivity analysis must sweep them.
var AFFINITY_P: f64 = 1.0
var AFFINITY_Q: f64 = 1.0

fn set_affinity(p: f64, q: f64) with Mut {
    AFFINITY_P = p
    AFFINITY_Q = q
}

// k_i(T) from the tabulated k25 and activation energy.
fn arrhenius_from_k25(log10_k25: f64, ea_kj_per_mol: f64, t_k: f64) -> f64 with Mut, Div, Panic {
    let k25 = exp(log10_k25 * 2.302585092994046)          // 10^log10_k25
    let ea_j = ea_kj_per_mol * 1000.0
    k25 * exp((0.0 - ea_j) / R_GAS * (1.0 / t_k - 1.0 / T_REF_K))
}

// The Lasaga affinity factor (1 - Omega^p)^q.
// Omega = Q/K: below 1 the mineral dissolves, above 1 it precipitates, and at
// exactly 1 the rate is zero. The sign of the result carries that direction.
fn affinity_factor(omega: f64) -> f64 with Mut, Div, Panic {
    if omega < 0.0 { return 0.0 }
    let op = exp(AFFINITY_P * log_safe(omega))
    let base = 1.0 - op
    if base >= 0.0 {
        return exp(AFFINITY_Q * log_safe(base))
    }
    // Supersaturated: (1 - Omega^p) is negative, so |.|^q carries the magnitude
    // and the sign is restored explicitly. Raising a negative base to a real
    // power is not defined, and guessing here would silently change a
    // precipitation rate into a dissolution rate.
    0.0 - exp(AFFINITY_Q * log_safe(0.0 - base))
}

// log with the zero and negative cases refused rather than returning an
// infinity that would propagate into a rate.
fn log_safe(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 745.0 }     // exp of this underflows to 0
    log(x)
}

// Total dissolution rate, mol m^-2 s^-1. Positive = dissolving.
//
//   t_k      temperature, K
//   a_h      activity of H+ (dimensionless)
//   p_co2    CO2 partial pressure, bar -- footnote d, NOT an activity
//   omega    saturation ratio Q/K
//
// Returns a negative sentinel rather than a number when the request is outside
// what the tabulated parameters support:
//   -1.0e30  temperature outside the range the compilation was fitted over
//   -2.0e30  negative activity or partial pressure
fn calcite_rate(t_k: f64, a_h: f64, p_co2: f64, omega: f64) -> f64 with Mut, Div, Panic {
    if t_k < 273.15 { return 0.0 - 1.0e30 }
    if t_k > 573.15 { return 0.0 - 1.0e30 }
    if a_h < 0.0 { return 0.0 - 2.0e30 }
    if p_co2 < 0.0 { return 0.0 - 2.0e30 }

    let k_acid = arrhenius_from_k25(LOG_K25_ACID, EA_ACID_KJ, t_k)
    let k_neut = arrhenius_from_k25(LOG_K25_NEUT, EA_NEUT_KJ, t_k)
    let k_carb = arrhenius_from_k25(LOG_K25_CARB, EA_CARB_KJ, t_k)

    var term_acid = 0.0
    if a_h > 0.0 { term_acid = k_acid * exp(N_ACID * log_safe(a_h)) }
    let term_neut = k_neut
    var term_carb = 0.0
    if p_co2 > 0.0 { term_carb = k_carb * exp(N_CARB * log_safe(p_co2)) }

    (term_acid + term_neut + term_carb) * affinity_factor(omega)
}

// ── printing (no float formatter exists; emit a scaled mantissa) ───────────
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") }
    else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") }
    else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") }
    else { print("9") }
}
fn pu64(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { pu64(x / 10) digit(x % 10) } else { digit(x) }
}
fn pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-") pu64(0 - x) } else { pu64(x) }
}
fn emit(label: string, v: f64) with IO, Mut, Div, Panic {
    print(label)
    print(" ")
    var neg = false
    var a = v
    if a < 0.0 { neg = true  a = 0.0 - a }
    if a == 0.0 { println("0") return }
    var e: i64 = 0
    while a >= 10.0 { a = a / 10.0  e = e + 1 }
    while a < 1.0 { a = a * 10.0  e = e - 1 }
    if neg { print("-") }
    pi64((a * 1.0e15) as i64)
    print("e")
    pi64(e - 15)
    println("")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("CALCITE DISSOLUTION RATE -- Palandri & Kharaka Table 33")
    println("mol m^-2 s^-1, mantissa scaled to 16 significant digits")
    println("")

    // Rate constants at 25 C must reproduce the table: 10^-0.30, 10^-5.81, 10^-3.48
    println("-- k25 reproduction (must equal 10^log10k of the table) --")
    emit("k25_acid  want 5.011872336272722e-01", arrhenius_from_k25(LOG_K25_ACID, EA_ACID_KJ, 298.15))
    emit("k25_neut  want 1.548816618912481e-06", arrhenius_from_k25(LOG_K25_NEUT, EA_NEUT_KJ, 298.15))
    emit("k25_carb  want 3.311311214825908e-04", arrhenius_from_k25(LOG_K25_CARB, EA_CARB_KJ, 298.15))
    println("")

    println("-- k(T) at the two field temperatures --")
    emit("k_neut_25C", arrhenius_from_k25(LOG_K25_NEUT, EA_NEUT_KJ, 298.15))
    emit("k_neut_40C_Lehen", arrhenius_from_k25(LOG_K25_NEUT, EA_NEUT_KJ, 313.15))
    emit("k_neut_70C", arrhenius_from_k25(LOG_K25_NEUT, EA_NEUT_KJ, 343.15))
    emit("k_neut_120C", arrhenius_from_k25(LOG_K25_NEUT, EA_NEUT_KJ, 393.15))
    println("")

    println("-- affinity factor, p=q=1 (the report's default) --")
    emit("omega=0.0_far_from_eq", affinity_factor(0.0))
    emit("omega=0.5", affinity_factor(0.5))
    emit("omega=1.0_at_equilibrium", affinity_factor(1.0))
    emit("omega=2.0_supersaturated", affinity_factor(2.0))
    println("")

    println("-- affinity factor with magnesite's measured p=4, q=1 --")
    set_affinity(4.0, 1.0)
    emit("omega=0.5_p4", affinity_factor(0.5))
    emit("omega=0.9_p4", affinity_factor(0.9))
    set_affinity(1.0, 1.0)
    emit("omega=0.9_p1", affinity_factor(0.9))
    println("")

    println("-- refusal controls --")
    emit("T=200K_out_of_range", calcite_rate(200.0, 1.0e-7, 0.01, 0.5))
    emit("negative_pCO2", calcite_rate(313.15, 1.0e-7, 0.0 - 1.0, 0.5))
    0
}
