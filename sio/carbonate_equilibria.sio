// Carbonate equilibria — the pH <-> CO2 loop, which is H2.
//
// H2 says the loop pH -> calcite precipitation -> CO2 cut makes the system
// self-limiting over part of the parameter space. This module is that loop's
// thermodynamics; nothing here asserts the hypothesis, it only makes it
// computable.
//
// PROVENANCE, AND A TRADEOFF THAT IS DECLARED RATHER THAN HIDDEN.
// Every constant below is read from `phreeqc.dat`, sha256
// 59373961d648dfbf68a40744060c1d64f57ecbec98f4f5fb89f3a1b4213ccd10 -- the same
// database the IPhreeqc oracle is pinned to. That is deliberate: sharing the
// thermodynamic data means a parity test against that oracle isolates the
// SOLVER, not the data. It also means such a test says nothing about whether
// the data are right. Swapping in `llnl.dat` measures the data contribution
// separately, and that is a distinct experiment, not a variation of this one.
//
// PHREEQC's analytic form, all five of them:
//   log10 K(T) = A1 + A2*T + A3/T + A4*log10(T) + A5/T^2 + A6*T^2   (T in K)
//
// NEGATIVE CONSTANTS ARE `var`. A module-level `let` of type f64 holding a
// negative value is silently wrong on this compiler (LANGUAGE_GAPS.md G9), and
// most coefficients below are negative.

// ── CO2(g) = CO2(aq), Henry ────────────────────────────────────────────────
var KH_A1: f64 = 10.5624
var KH_A2: f64 = 0.0 - 2.3547e-2
var KH_A3: f64 = 0.0 - 3972.8
var KH_A4: f64 = 0.0
var KH_A5: f64 = 5.8746e5
var KH_A6: f64 = 1.9194e-5
var KH_LOGK25: f64 = 0.0 - 1.468

// ── CO3-2 + H+ = HCO3-   (the reciprocal of K2) ────────────────────────────
var KB_A1: f64 = 107.8871
var KB_A2: f64 = 0.03252849
var KB_A3: f64 = 0.0 - 5151.79
var KB_A4: f64 = 0.0 - 38.92561
var KB_A5: f64 = 563713.9
var KB_A6: f64 = 0.0
var KB_LOGK25: f64 = 10.329

// ── CO3-2 + 2 H+ = CO2 + H2O   (the reciprocal of K1*K2) ───────────────────
var KC_A1: f64 = 464.1965
var KC_A2: f64 = 0.09344813
var KC_A3: f64 = 0.0 - 26986.16
var KC_A4: f64 = 0.0 - 165.75951
var KC_A5: f64 = 2248628.9
var KC_A6: f64 = 0.0
var KC_LOGK25: f64 = 16.681

// ── H2O = OH- + H+ ─────────────────────────────────────────────────────────
var KW_A1: f64 = 293.29227
var KW_A2: f64 = 0.1360833
var KW_A3: f64 = 0.0 - 10576.913
var KW_A4: f64 = 0.0 - 123.73158
var KW_A5: f64 = 0.0
var KW_A6: f64 = 0.0 - 6.996455e-5
var KW_LOGK25: f64 = 0.0 - 14.0

// ── Calcite: CaCO3 = CO3-2 + Ca+2 ──────────────────────────────────────────
// The database annotates this one "0 - 250 C, Ellis 1959, Plummer and
// Busenberg 1982", and gives only three coefficients.
var KSP_A1: f64 = 17.118
var KSP_A2: f64 = 0.0 - 0.046528
var KSP_A3: f64 = 0.0 - 3496.0
var KSP_A4: f64 = 0.0
var KSP_A5: f64 = 0.0
var KSP_A6: f64 = 0.0
var KSP_LOGK25: f64 = 0.0 - 8.48

// ── ion pairs, from the same pinned database ───────────────────────────────
// Ca+2 + CO3-2 + H+ = CaHCO3+   log_k 10.91,  -gamma 6 0
var P1_A1: f64 = 0.0 - 6.009
var P1_A2: f64 = 3.377e-2
var P1_A3: f64 = 2044.0
// Ca+2 + CO3-2 = CaCO3 (aq)     log_k 3.224, uncharged, NO -gamma line
var P2_A1: f64 = 0.0 - 1228.732
var P2_A2: f64 = 0.0 - 0.29944
var P2_A3: f64 = 35512.75
var P2_A4: f64 = 485.818
// Ca+2 + H2O = CaOH+ + H+       log_k -12.78, no analytic and no -gamma:
// temperature-independent here, and Davies for its activity coefficient.
var P3_LOGK: f64 = 0.0 - 12.78

// Background NaCl. It raises ionic strength -- and therefore every activity
// coefficient -- without entering the carbonate charge balance, since Na+ and
// Cl- balance each other. Set by the caller before solving.
pub var BACKGROUND_NACL: f64 = 0.0

pub var LN10: f64 = 2.302585092994046

fn log10_of(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 745.0 }
    log(x) / LN10
}

// The analytic form. `which` selects the reaction, because passing six
// coefficients plus T would exceed the parameter count that compiles reliably
// for imported calls on this lane.
//   0 Henry   1 CO3+H   2 CO3+2H   3 water   4 calcite
pub fn log_k(which: i64, t_k: f64) -> f64 with Mut, Div, Panic {
    var a1 = 0.0
    var a2 = 0.0
    var a3 = 0.0
    var a4 = 0.0
    var a5 = 0.0
    var a6 = 0.0
    if which == 0 {
        a1 = KH_A1  a2 = KH_A2  a3 = KH_A3  a4 = KH_A4  a5 = KH_A5  a6 = KH_A6
    } else if which == 1 {
        a1 = KB_A1  a2 = KB_A2  a3 = KB_A3  a4 = KB_A4  a5 = KB_A5  a6 = KB_A6
    } else if which == 2 {
        a1 = KC_A1  a2 = KC_A2  a3 = KC_A3  a4 = KC_A4  a5 = KC_A5  a6 = KC_A6
    } else if which == 3 {
        a1 = KW_A1  a2 = KW_A2  a3 = KW_A3  a4 = KW_A4  a5 = KW_A5  a6 = KW_A6
    } else if which == 4 {
        a1 = KSP_A1 a2 = KSP_A2 a3 = KSP_A3 a4 = KSP_A4 a5 = KSP_A5 a6 = KSP_A6
    } else if which == 5 {
        a1 = P1_A1  a2 = P1_A2  a3 = P1_A3
    } else if which == 6 {
        a1 = P2_A1  a2 = P2_A2  a3 = P2_A3  a4 = P2_A4
    } else {
        return P3_LOGK
    }
    a1 + a2 * t_k + a3 / t_k + a4 * log10_of(t_k) + a5 / (t_k * t_k) + a6 * t_k * t_k
}

// Derived dissociation constants, in the direction chemists write them.
//   pK1 for  CO2 + H2O = H+ + HCO3-
//   pK2 for  HCO3-     = H+ + CO3-2
pub fn p_k1(t_k: f64) -> f64 with Mut, Div, Panic { log_k(2, t_k) - log_k(1, t_k) }
pub fn p_k2(t_k: f64) -> f64 with Mut, Div, Panic { log_k(1, t_k) }

// Speciation at a GIVEN pH. This does not solve for pH: closing the system on
// charge balance is a separate step, and pretending otherwise would hide which
// constraint produced a number.
//
//   [CO2(aq)]  = K_H * P_CO2
//   [HCO3-]    = [CO2] * 10^(-pK1) / [H+]
//   [CO3-2]    = [HCO3-] * 10^(-pK2) / [H+]
fn co2_aq(t_k: f64, p_co2_atm: f64) -> f64 with Mut, Div, Panic {
    if p_co2_atm < 0.0 { return 0.0 - 1.0 }
    exp(log_k(0, t_k) * LN10) * p_co2_atm
}

fn hco3(t_k: f64, p_co2_atm: f64, ph: f64) -> f64 with Mut, Div, Panic {
    let c = co2_aq(t_k, p_co2_atm)
    if c < 0.0 { return 0.0 - 1.0 }
    c * exp((0.0 - p_k1(t_k)) * LN10) / exp((0.0 - ph) * LN10)
}

fn co3(t_k: f64, p_co2_atm: f64, ph: f64) -> f64 with Mut, Div, Panic {
    let b = hco3(t_k, p_co2_atm, ph)
    if b < 0.0 { return 0.0 - 1.0 }
    b * exp((0.0 - p_k2(t_k)) * LN10) / exp((0.0 - ph) * LN10)
}

// Calcite saturation ratio. This is the quantity the rate law's affinity term
// consumes, so the two modules meet here.
fn omega_calcite(t_k: f64, p_co2_atm: f64, ph: f64, ca_molal: f64) -> f64 with Mut, Div, Panic {
    if ca_molal < 0.0 { return 0.0 - 1.0 }
    let c3 = co3(t_k, p_co2_atm, ph)
    if c3 < 0.0 { return 0.0 - 1.0 }
    ca_molal * c3 / exp(log_k(4, t_k) * LN10)
}


var AVOGADRO_PHREEQC: f64 = 6.02252e23
var PI_C: f64 = 3.141592653589793
var LN10_A: f64 = 2.302585092994046

// Wagner & Pruss eqn 2.6 coefficients
var WP_B1: f64 = 1.99274064
var WP_B2: f64 = 1.09965342
var WP_B3: f64 = 0.0 - 0.510839303
var WP_B4: f64 = 0.0 - 1.75493479
var WP_B5: f64 = 0.0 - 45.5170352
var WP_B6: f64 = 0.0 - 6.7469445e5
var WP_TC: f64 = 647.096

// Bradley & Pitzer coefficients
var BP_U1: f64 = 3.4279e2
var BP_U2: f64 = 0.0 - 5.0866e-3
var BP_U3: f64 = 9.469e-7
var BP_U4: f64 = 0.0 - 2.0525
var BP_U5: f64 = 3.1159e3
var BP_U6: f64 = 0.0 - 1.8289e2
var BP_U7: f64 = 0.0 - 8.0325e3
var BP_U8: f64 = 4.2142e6
var BP_U9: f64 = 2.1417

pub fn powf(x: f64, y: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    exp(y * log(x))
}

pub fn sqrtf(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    exp(0.5 * log(x))
}

// Saturation-line density, kg/m^3, Wagner & Pruss eqn 2.6.
fn rho_sat(tc: f64) -> f64 with Mut, Div, Panic {
    let t = tc + 273.15
    let th = 1.0 - t / WP_TC
    if th <= 0.0 { return 0.0 - 1.0 }
    322.0 * (1.0 + WP_B1 * powf(th, 1.0 / 3.0)
                 + WP_B2 * powf(th, 2.0 / 3.0)
                 + WP_B3 * powf(th, 5.0 / 3.0)
                 + WP_B4 * powf(th, 16.0 / 3.0)
                 + WP_B5 * powf(th, 43.0 / 3.0)
                 + WP_B6 * powf(th, 110.0 / 3.0))
}

// Saturation pressure, atm, as PHREEQC writes it (a_H2O taken as 1 here).
fn p_sat_atm(tc: f64) -> f64 with Mut, Div, Panic {
    let t = tc + 273.15
    exp(11.6702 - 3816.44 / (t - 46.13))
}

// Pure-water density in g/cm^3 at (tc, pa in atm).
fn rho_0(tc: f64, pa_atm: f64) -> f64 with Mut, Div, Panic {
    let rs = rho_sat(tc)
    if rs < 0.0 { return 0.0 - 1.0 }
    let p0 = 5.1880000e-02 + tc * (0.0 - 4.1885519e-04 + tc * (6.6780748e-06 + tc * (0.0 - 3.6648699e-08 + tc * 8.3501912e-11)))
    let p1 = 0.0 - 6.0251348e-06 + tc * (3.6696407e-07 + tc * (0.0 - 9.2056269e-09 + tc * (6.7024182e-11 + tc * (0.0 - 1.5947241e-13))))
    let p2 = 0.0 - 2.2983596e-09 + tc * (0.0 - 4.0133819e-10 + tc * (1.2619821e-11 + tc * (0.0 - 9.8952363e-14 + tc * 2.3363281e-16)))
    let p3 = 7.0517647e-11 + tc * (6.8566831e-12 + tc * (0.0 - 2.2829750e-13 + tc * (1.8113313e-15 + tc * (0.0 - 4.2475324e-18))))
    let ps = p_sat_atm(tc)
    var pa = pa_atm
    if pa < ps { pa = ps }
    pa = pa - (ps - 1.0e-6)
    let r = rs + pa * (p0 + pa * (p1 + pa * (p2 + sqrtf(pa) * p3)))
    r / 1000.0
}

// Relative dielectric constant, Bradley & Pitzer 1979.
fn eps_r(tc: f64, pa_atm: f64) -> f64 with Mut, Div, Panic {
    let t = tc + 273.15
    let d1000 = BP_U1 * exp(t * (BP_U2 + t * BP_U3))
    let c = BP_U4 + BP_U5 / (BP_U6 + t)
    let b = BP_U7 + BP_U8 / t + BP_U9 * t
    let pb = pa_atm * 1.01325
    d1000 + c * log((b + pb) / (b + 1000.0))
}

// Debye-Hückel B, in 1/Angstrom per (mol/kg)^0.5.
pub fn dh_b(tc: f64, pa_atm: f64) -> f64 with Mut, Div, Panic {
    let t = tc + 273.15
    let e = eps_r(tc, pa_atm)
    if e <= 0.0 { return 0.0 - 1.0 }
    let e2_dkt = 1.671008e-3 / (e * t)
    let r0 = rho_0(tc, pa_atm)
    if r0 < 0.0 { return 0.0 - 1.0 }
    // The /1e3 is NOT a unit conversion. PHREEQC's caller overwrites the
    // rho_0 member with calc_rho_0's RETURN value, which is already g/cm^3,
    // so the division in the formula is a genuine extra factor. Reading it
    // as a conversion and cancelling it puts A and B out by sqrt(1000) --
    // which is exactly what the 25 C validation below caught.
    sqrtf(8.0 * PI_C * AVOGADRO_PHREEQC * e2_dkt * r0 / 1000.0) / 1.0e8
}

// Debye-Hückel A, in (mol/kg)^-0.5. Note DH_A is formed from DH_B BEFORE the
// 1e8 division in PHREEQC, so the factor is restored here.
pub fn dh_a(tc: f64, pa_atm: f64) -> f64 with Mut, Div, Panic {
    let t = tc + 273.15
    let e = eps_r(tc, pa_atm)
    if e <= 0.0 { return 0.0 - 1.0 }
    let e2_dkt = 1.671008e-3 / (e * t)
    let b_pre = dh_b(tc, pa_atm) * 1.0e8
    b_pre * e2_dkt / (2.0 * LN10_A)
}

// WATEQ Debye-Hückel activity coefficient.
//   z  charge (0 for a neutral species)
//   a  ion-size parameter, Angstrom, from the database's -gamma line
//   b  WATEQ extension term, from the same line
// A neutral species (z = 0, a = 0) reduces to the Setchenow form log g = b mu.
pub fn gamma_wateq(tc: f64, pa_atm: f64, z: f64, a: f64, b: f64, mu: f64) -> f64 with Mut, Div, Panic {
    if mu < 0.0 { return 0.0 - 1.0 }
    if mu == 0.0 { return 1.0 }
    let sm = sqrtf(mu)
    let aa = dh_a(tc, pa_atm)
    let bb = dh_b(tc, pa_atm)
    if aa < 0.0 { return 0.0 - 1.0 }
    let lg = (0.0 - aa) * z * z * sm / (1.0 + bb * a * sm) + b * mu
    exp(lg * LN10_A)
}



// ── activity-aware closure ─────────────────────────────────────────────────
//
// The same electroneutrality condition, but the equilibrium constants now act
// on ACTIVITIES and the charge balance on CONCENTRATIONS, with WATEQ
// Debye-Huckel connecting them. Ionic strength depends on the concentrations,
// which depend on the activity coefficients, which depend on ionic strength, so
// this is a nested iteration: an inner bisection on pH inside an outer fixed
// point on mu.
//
// pH here is -log10(a_H), which is what the oracle reports, so the two are
// comparable without a further convention.

var SP_M_CA: f64 = 0.0        // free Ca2+
var SP_M_CAHCO3: f64 = 0.0
var SP_M_CACO3: f64 = 0.0
var SP_M_CAOH: f64 = 0.0
pub var SP_M_TOTAL_CA: f64 = 0.0  // what the oracle's `Ca` column reports
var SP_CHARGE: f64 = 0.0
pub var SP_MU: f64 = 0.0

// Carbon-bearing species, added alongside the calcium accounting above.
// Additive only -- nothing here changes an existing SP_ value or the pH this
// module already solves for. Exists so a caller can read total dissolved
// inorganic carbon (DIC) at calcite equilibrium, for the coupled model's
// with-calcite branch: DIC = CO2(aq) + HCO3- + CO3-2 + CaHCO3+ + CaCO3(aq).
pub var SP_M_CO2: f64 = 0.0
pub var SP_M_HCO3: f64 = 0.0
pub var SP_M_CO3: f64 = 0.0
pub var SP_DIC: f64 = 0.0

// Full speciation at a given pH and ionic strength, pairs included.
// PHREEQC reports TOTAL calcium, so the comparison is only like-for-like once
// the pairs are summed -- part of the residual this is testing was free Ca2+
// being compared against a total.
pub fn speciate(t_k: f64, p_co2_atm: f64, ph: f64, mu: f64) with Mut, Div, Panic {
    let tc = t_k - 273.15
    let g_h    = gamma_wateq(tc, 1.0, 1.0, 9.0, 0.0,   mu)
    let g_oh   = gamma_wateq(tc, 1.0, 1.0, 3.5, 0.0,   mu)
    let g_hco3 = gamma_wateq(tc, 1.0, 1.0, 5.4, 0.0,   mu)
    let g_co3  = gamma_wateq(tc, 1.0, 2.0, 5.4, 0.0,   mu)
    let g_ca   = gamma_wateq(tc, 1.0, 2.0, 5.0, 0.165, mu)
    let g_cahco3 = gamma_wateq(tc, 1.0, 1.0, 6.0, 0.0, mu)
    let g_caoh   = gamma_davies(tc, 1.0, mu)
    // CaCO3(aq) is uncharged with no -gamma line: PHREEQC gflag 0 with dhb = 0,
    // i.e. activity coefficient exactly 1.
    let g_caco3  = 1.0

    let a_h    = exp((0.0 - ph) * LN10)
    let a_oh   = exp(log_k(3, t_k) * LN10) / a_h
    let a_co2  = exp(log_k(0, t_k) * LN10) * p_co2_atm
    let a_hco3 = a_co2 * exp((0.0 - p_k1(t_k)) * LN10) / a_h
    let a_co3  = a_hco3 * exp((0.0 - p_k2(t_k)) * LN10) / a_h
    if a_co3 <= 0.0 {
        SP_M_TOTAL_CA = 0.0  SP_CHARGE = 0.0  SP_MU = mu
        SP_M_CO2 = 0.0  SP_M_HCO3 = 0.0  SP_M_CO3 = 0.0  SP_DIC = 0.0
        return
    }
    let a_ca   = exp(log_k(4, t_k) * LN10) / a_co3

    let a_cahco3 = a_ca * a_co3 * a_h * exp(log_k(5, t_k) * LN10)
    let a_caco3  = a_ca * a_co3 * exp(log_k(6, t_k) * LN10)
    let a_caoh   = a_ca * exp(log_k(7, t_k) * LN10) / a_h

    let m_h      = a_h / g_h
    let m_oh     = a_oh / g_oh
    let m_hco3   = a_hco3 / g_hco3
    let m_co3    = a_co3 / g_co3
    let m_ca     = a_ca / g_ca
    let m_cahco3 = a_cahco3 / g_cahco3
    let m_caco3  = a_caco3 / g_caco3
    let m_caoh   = a_caoh / g_caoh

    // CO2(aq) is uncharged, no -gamma line: activity coefficient exactly 1,
    // same convention as CaCO3(aq) above.
    let m_co2 = a_co2

    SP_M_CA = m_ca
    SP_M_CAHCO3 = m_cahco3
    SP_M_CACO3 = m_caco3
    SP_M_CAOH = m_caoh
    SP_M_TOTAL_CA = m_ca + m_cahco3 + m_caco3 + m_caoh
    SP_M_CO2 = m_co2
    SP_M_HCO3 = m_hco3
    SP_M_CO3 = m_co3
    SP_DIC = m_co2 + m_hco3 + m_co3 + m_cahco3 + m_caco3
    SP_CHARGE = 2.0 * m_ca + m_h + m_cahco3 + m_caoh - m_hco3 - 2.0 * m_co3 - m_oh
    SP_MU = 0.5 * (4.0 * m_ca + m_h + m_hco3 + 4.0 * m_co3 + m_oh
                   + m_cahco3 + m_caoh) + BACKGROUND_NACL
}

pub fn solve_ph_pairs(t_k: f64, p_co2_atm: f64) -> f64 with Mut, Div, Panic {
    var mu = 0.0
    var ph = 7.0
    var n: i64 = 0
    while n < 200 {
        var lo = 3.0
        var hi = 13.0
        speciate(t_k, p_co2_atm, lo, mu)
        let f_lo = SP_CHARGE
        var k: i64 = 0
        while k < 60 {
            let mid = 0.5 * (lo + hi)
            speciate(t_k, p_co2_atm, mid, mu)
            if (f_lo < 0.0 && SP_CHARGE < 0.0) || (f_lo > 0.0 && SP_CHARGE > 0.0) { lo = mid } else { hi = mid }
            k = k + 1
        }
        ph = 0.5 * (lo + hi)
        speciate(t_k, p_co2_atm, ph, mu)
        let d = SP_MU - mu
        var ad = d
        if ad < 0.0 { ad = 0.0 - ad }
        mu = SP_MU
        n = n + 1
        if ad < 1.0e-15 { n = 200 }
    }
    speciate(t_k, p_co2_atm, ph, mu)
    MU_ITERS = n
    ph
}

// ── the no-calcite carbonate closure ──────────────────────────────────────
//
// The SAME charge balance as solve_ph_pairs above with every calcium term
// removed:   H+ = HCO3- + 2 CO3-2 + OH-
//
// This is NOT a subtraction from the calcite closure -- it is a smaller system
// with its own root, and it exists because the coupled model needs to know what
// carbon a CO2 stream alone puts into solution when no mineral buffers it.
// Structurally identical to solve_ph_pairs on purpose, so the two branches
// differ only in the physics they contain and never in the method used.
//
// Lives here rather than in a caller because it is a carbonate equilibrium, and
// because two coupled models now need the same one -- a second copy would be a
// second thing to keep correct.

pub var NC_DIC: f64 = 0.0
pub var NC_HCO3: f64 = 0.0
var NC_CHARGE: f64 = 0.0
var NC_MU: f64 = 0.0

fn speciate_nocalcite(t_k: f64, p_co2_atm: f64, ph: f64, mu: f64) with Mut, Div, Panic {
    let tc = t_k - 273.15
    let g_h    = gamma_wateq(tc, 1.0, 1.0, 9.0, 0.0, mu)
    let g_oh   = gamma_wateq(tc, 1.0, 1.0, 3.5, 0.0, mu)
    let g_hco3 = gamma_wateq(tc, 1.0, 1.0, 5.4, 0.0, mu)
    let g_co3  = gamma_wateq(tc, 1.0, 2.0, 5.4, 0.0, mu)

    let a_h    = exp((0.0 - ph) * LN10)
    let a_oh   = exp(log_k(3, t_k) * LN10) / a_h
    let a_co2  = exp(log_k(0, t_k) * LN10) * p_co2_atm
    let a_hco3 = a_co2 * exp((0.0 - p_k1(t_k)) * LN10) / a_h
    let a_co3  = a_hco3 * exp((0.0 - p_k2(t_k)) * LN10) / a_h

    let m_h    = a_h / g_h
    let m_oh   = a_oh / g_oh
    let m_hco3 = a_hco3 / g_hco3
    let m_co3  = a_co3 / g_co3
    // CO2(aq) is uncharged with no -gamma line: activity coefficient exactly 1,
    // the same PHREEQC convention used for CaCO3(aq) above.
    let m_co2  = a_co2

    NC_CHARGE = m_h - m_hco3 - 2.0 * m_co3 - m_oh
    NC_MU     = 0.5 * (m_h + m_hco3 + 4.0 * m_co3 + m_oh) + BACKGROUND_NACL
    NC_DIC    = m_co2 + m_hco3 + m_co3
    NC_HCO3   = m_hco3
}

pub fn solve_nocalcite(t_k: f64, p_co2_atm: f64) -> f64 with Mut, Div, Panic {
    var mu = 0.0
    var ph = 5.0
    var n: i64 = 0
    while n < 200 {
        var lo = 2.0
        var hi = 10.0
        speciate_nocalcite(t_k, p_co2_atm, lo, mu)
        let f_lo = NC_CHARGE
        var k: i64 = 0
        while k < 60 {
            let mid = 0.5 * (lo + hi)
            speciate_nocalcite(t_k, p_co2_atm, mid, mu)
            if (f_lo < 0.0 && NC_CHARGE < 0.0) || (f_lo > 0.0 && NC_CHARGE > 0.0) { lo = mid } else { hi = mid }
            k = k + 1
        }
        ph = 0.5 * (lo + hi)
        speciate_nocalcite(t_k, p_co2_atm, ph, mu)
        let d = NC_MU - mu
        var ad = d
        if ad < 0.0 { ad = 0.0 - ad }
        mu = NC_MU
        n = n + 1
        if ad < 1.0e-15 { n = 200 }
    }
    speciate_nocalcite(t_k, p_co2_atm, ph, mu)
    ph
}

var MU_LAST: f64 = 0.0
var MU_ITERS: i64 = 0

// Charge residual at a GIVEN ionic strength, so the outer loop can hold it fixed.
fn charge_residual_act(t_k: f64, p_co2_atm: f64, ph: f64, mu: f64) -> f64 with Mut, Div, Panic {
    let tc = t_k - 273.15
    let g_h    = gamma_wateq(tc, 1.0, 1.0, 9.0, 0.0,   mu)
    let g_oh   = gamma_wateq(tc, 1.0, 1.0, 3.5, 0.0,   mu)
    let g_hco3 = gamma_wateq(tc, 1.0, 1.0, 5.4, 0.0,   mu)
    let g_co3  = gamma_wateq(tc, 1.0, 2.0, 5.4, 0.0,   mu)
    let g_ca   = gamma_wateq(tc, 1.0, 2.0, 5.0, 0.165, mu)
    let g_co2  = gamma_wateq(tc, 1.0, 0.0, 0.0, 0.066, mu)
    if g_h < 0.0 { return 0.0 }

    let a_h    = exp((0.0 - ph) * LN10)
    let a_oh   = exp(log_k(3, t_k) * LN10) / a_h
    // Henry gives the CO2 activity from the imposed partial pressure.
    let a_co2  = exp(log_k(0, t_k) * LN10) * p_co2_atm
    let a_hco3 = a_co2 * exp((0.0 - p_k1(t_k)) * LN10) / a_h
    let a_co3  = a_hco3 * exp((0.0 - p_k2(t_k)) * LN10) / a_h
    if a_co3 <= 0.0 { return 0.0 }
    let a_ca   = exp(log_k(4, t_k) * LN10) / a_co3

    let m_h    = a_h / g_h
    let m_oh   = a_oh / g_oh
    let m_hco3 = a_hco3 / g_hco3
    let m_co3  = a_co3 / g_co3
    let m_ca   = a_ca / g_ca

    2.0 * m_ca + m_h - m_hco3 - 2.0 * m_co3 - m_oh
}

fn ionic_strength_at(t_k: f64, p_co2_atm: f64, ph: f64, mu: f64) -> f64 with Mut, Div, Panic {
    let tc = t_k - 273.15
    let g_h    = gamma_wateq(tc, 1.0, 1.0, 9.0, 0.0,   mu)
    let g_oh   = gamma_wateq(tc, 1.0, 1.0, 3.5, 0.0,   mu)
    let g_hco3 = gamma_wateq(tc, 1.0, 1.0, 5.4, 0.0,   mu)
    let g_co3  = gamma_wateq(tc, 1.0, 2.0, 5.4, 0.0,   mu)
    let g_ca   = gamma_wateq(tc, 1.0, 2.0, 5.0, 0.165, mu)
    let a_h    = exp((0.0 - ph) * LN10)
    let a_oh   = exp(log_k(3, t_k) * LN10) / a_h
    let a_co2  = exp(log_k(0, t_k) * LN10) * p_co2_atm
    let a_hco3 = a_co2 * exp((0.0 - p_k1(t_k)) * LN10) / a_h
    let a_co3  = a_hco3 * exp((0.0 - p_k2(t_k)) * LN10) / a_h
    if a_co3 <= 0.0 { return 0.0 }
    let a_ca   = exp(log_k(4, t_k) * LN10) / a_co3
    0.5 * (4.0 * (a_ca / g_ca) + a_h / g_h + a_hco3 / g_hco3
           + 4.0 * (a_co3 / g_co3) + a_oh / g_oh) + BACKGROUND_NACL
}

fn solve_ph_at_mu(t_k: f64, p_co2_atm: f64, mu: f64) -> f64 with Mut, Div, Panic {
    var lo = 3.0
    var hi = 13.0
    let f_lo = charge_residual_act(t_k, p_co2_atm, lo, mu)
    if f_lo == 0.0 { return 0.0 - 1.0 }
    var mid = 0.5 * (lo + hi)
    var n: i64 = 0
    while n < 60 {
        mid = 0.5 * (lo + hi)
        let f_mid = charge_residual_act(t_k, p_co2_atm, mid, mu)
        if (f_lo < 0.0 && f_mid < 0.0) || (f_lo > 0.0 && f_mid > 0.0) { lo = mid } else { hi = mid }
        n = n + 1
    }
    mid
}

// Outer fixed point on ionic strength. Returns pH; MU_LAST holds the converged
// ionic strength and MU_ITERS the number of outer sweeps actually taken.
fn solve_ph_activity(t_k: f64, p_co2_atm: f64) -> f64 with Mut, Div, Panic {
    var mu = 0.0
    var ph = 7.0
    var n: i64 = 0
    while n < 60 {
        ph = solve_ph_at_mu(t_k, p_co2_atm, mu)
        let mu_new = ionic_strength_at(t_k, p_co2_atm, ph, mu)
        let d = mu_new - mu
        var ad = d
        if ad < 0.0 { ad = 0.0 - ad }
        mu = mu_new
        n = n + 1
        if ad < 1.0e-14 { n = 60 }
    }
    MU_LAST = mu
    MU_ITERS = n
    ph
}

fn ca_activity_model(t_k: f64, p_co2_atm: f64, ph: f64, mu: f64) -> f64 with Mut, Div, Panic {
    let tc = t_k - 273.15
    let g_ca  = gamma_wateq(tc, 1.0, 2.0, 5.0, 0.165, mu)
    let g_co3 = gamma_wateq(tc, 1.0, 2.0, 5.4, 0.0,   mu)
    let a_h   = exp((0.0 - ph) * LN10)
    let a_co2 = exp(log_k(0, t_k) * LN10) * p_co2_atm
    let a_hco3 = a_co2 * exp((0.0 - p_k1(t_k)) * LN10) / a_h
    let a_co3 = a_hco3 * exp((0.0 - p_k2(t_k)) * LN10) / a_h
    if a_co3 <= 0.0 { return 0.0 - 1.0 }
    (exp(log_k(4, t_k) * LN10) / a_co3) / g_ca
}

// ── charge-balance closure ─────────────────────────────────────────────────
//
// The system closes on electroneutrality. For calcite in contact with a gas
// phase of fixed P(CO2), with no other ions present:
//
//   2[Ca2+] + [H+]  =  [HCO3-] + 2[CO3-2] + [OH-]
//
// and calcite equilibrium supplies the calcium:  [Ca2+] = Ksp / [CO3-2].
// Everything on both sides is a function of pH alone once T and P(CO2) are
// fixed, so this is one equation in one unknown.
//
// IDEAL SOLUTION. Activity coefficients are unity here; concentrations and
// activities are not distinguished. The oracle uses Debye-Huckel, so a parity
// comparison against it carries the ACTIVITY MODEL as a named difference, not
// as an unexplained residual. At the ionic strengths of interest that term is
// not small, and pretending the two solve the same problem would be false.

var CB_ITERS: i64 = 0          // iterations the last solve actually took
var CB_RESIDUAL: f64 = 0.0     // charge residual at the returned root

// Signed charge imbalance, in equivalents per kg water. Positive means excess
// cation charge, so pH must rise.
fn charge_residual(t_k: f64, p_co2_atm: f64, ph: f64) -> f64 with Mut, Div, Panic {
    let h = exp((0.0 - ph) * LN10)
    let oh = exp(log_k(3, t_k) * LN10) / h
    let b = hco3(t_k, p_co2_atm, ph)
    let c3 = co3(t_k, p_co2_atm, ph)
    if b < 0.0 { return 0.0 }
    if c3 <= 0.0 { return 0.0 }
    let ca = exp(log_k(4, t_k) * LN10) / c3
    2.0 * ca + h - b - 2.0 * c3 - oh
}

// Bisection. Chosen over Newton deliberately: it needs no derivative, it cannot
// diverge, and its error bound after n steps is exactly (hi-lo)/2^n, so the
// convergence claim is arithmetic rather than a hope. The iteration count and
// the residual at the root are both recorded and reported -- a root is not
// claimed, it is exhibited.
//
// Returns a negative sentinel rather than a number when it cannot bracket:
//   -1.0  the interval endpoints do not straddle a sign change
fn solve_ph(t_k: f64, p_co2_atm: f64, ph_lo: f64, ph_hi: f64, tol: f64) -> f64 with Mut, Div, Panic {
    var lo = ph_lo
    var hi = ph_hi
    let f_lo = charge_residual(t_k, p_co2_atm, lo)
    let f_hi = charge_residual(t_k, p_co2_atm, hi)
    CB_ITERS = 0
    CB_RESIDUAL = 0.0
    // Refuse rather than return an endpoint dressed as a root.
    if f_lo > 0.0 && f_hi > 0.0 { return 0.0 - 1.0 }
    if f_lo < 0.0 && f_hi < 0.0 { return 0.0 - 1.0 }
    var mid = 0.5 * (lo + hi)
    var n: i64 = 0
    while n < 200 {
        mid = 0.5 * (lo + hi)
        let f_mid = charge_residual(t_k, p_co2_atm, mid)
        if hi - lo < tol { n = 200 } else {
            if (f_lo < 0.0 && f_mid < 0.0) || (f_lo > 0.0 && f_mid > 0.0) {
                lo = mid
            } else {
                hi = mid
            }
            n = n + 1
            CB_ITERS = CB_ITERS + 1
        }
    }
    CB_RESIDUAL = charge_residual(t_k, p_co2_atm, mid)
    mid
}

// Davies. PHREEQC uses this for a charged species with no -gamma line
// (gflag 1): log g = -A z^2 (sqrt(mu)/(1+sqrt(mu)) - 0.3 mu).
pub fn gamma_davies(tc: f64, z: f64, mu: f64) -> f64 with Mut, Div, Panic {
    if mu <= 0.0 { return 1.0 }
    let sm = sqrtf(mu)
    let aa = dh_a(tc, 1.0)
    if aa < 0.0 { return 0.0 - 1.0 }
    exp(((0.0 - aa) * z * z * (sm / (1.0 + sm) - 0.3 * mu)) * LN10_A)
}

// ── printing ───────────────────────────────────────────────────────────────
fn digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") }
    else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") }
    else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") }
    else { print("9") }
}
fn pu64(x: i64) with IO, Mut, Div, Panic { if x >= 10 { pu64(x / 10) digit(x % 10) } else { digit(x) } }
fn pi64(x: i64) with IO, Mut, Div, Panic { if x < 0 { print("-") pu64(0 - x) } else { pu64(x) } }

fn emit(label: string, v: f64) with IO, Mut, Div, Panic {
    print(label) print(" ")
    var neg = false
    var a = v
    if a < 0.0 { neg = true  a = 0.0 - a }
    if a == 0.0 { println("0") return }
    var e: i64 = 0
    while a >= 10.0 { a = a / 10.0  e = e + 1 }
    while a < 1.0 { a = a * 10.0  e = e - 1 }
    if neg { print("-") }
    pi64((a * 1.0e12) as i64) print("e") pi64(e - 12)
    println("")
}

// Self-check: the analytic expression evaluated at 298.15 K must reproduce the
// database's own -log_k line. If it does not, the form above was misread, and
// every number downstream is wrong. Reported as a residual, not asserted.
fn selfcheck(label: string, which: i64, tabulated: f64) with IO, Mut, Div, Panic {
    let computed = log_k(which, 298.15)
    print(label) print("  tabulated ") emit("", tabulated)
    print("          computed  ") emit("", computed)
    print("          residual  ") emit("", computed - tabulated)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("CARBONATE EQUILIBRIA -- constants from the pinned phreeqc.dat")
    println("")
    println("== self-check: analytic form at 298.15 K vs the database's log_k ==")
    selfcheck("Henry CO2(g)   ", 0, KH_LOGK25)
    selfcheck("CO3-2 + H+     ", 1, KB_LOGK25)
    selfcheck("CO3-2 + 2H+    ", 2, KC_LOGK25)
    selfcheck("water Kw       ", 3, KW_LOGK25)
    selfcheck("calcite Ksp    ", 4, KSP_LOGK25)
    println("")

    println("== derived dissociation constants (textbook: pK1 6.35, pK2 10.33) ==")
    emit("pK1_25C", p_k1(298.15))
    emit("pK2_25C", p_k2(298.15))
    emit("pK1_40C", p_k1(313.15))
    emit("pK2_40C", p_k2(313.15))
    println("")

    println("== speciation at 40 C, P(CO2) = 0.01 atm ==")
    emit("CO2_aq_pH7 ", co2_aq(313.15, 0.01))
    emit("HCO3_pH7   ", hco3(313.15, 0.01, 7.0))
    emit("CO3_pH7    ", co3(313.15, 0.01, 7.0))
    emit("HCO3_pH9   ", hco3(313.15, 0.01, 9.0))
    emit("CO3_pH9    ", co3(313.15, 0.01, 9.0))
    println("")

    println("== calcite saturation, Ca = 1e-3 molal ==")
    emit("omega_pH7 ", omega_calcite(313.15, 0.01, 7.0, 1.0e-3))
    emit("omega_pH8 ", omega_calcite(313.15, 0.01, 8.0, 1.0e-3))
    emit("omega_pH9 ", omega_calcite(313.15, 0.01, 9.0, 1.0e-3))
    println("")
    println("== charge-balance closure: calcite + CO2(g), ideal solution ==")
    println("   (activity coefficients are unity here; the oracle uses Debye-Huckel)")
    var i: i64 = 0
    var pcs: [f64; 4] = [0.0; 4]
    pcs[0] = 0.0003162277660168379    // 10^-3.5, atmospheric
    pcs[1] = 0.01
    pcs[2] = 0.1
    pcs[3] = 1.0
    while i < 4 {
        let ph = solve_ph(313.15, pcs[i], 4.0, 12.0, 1.0e-12)
        print("P_CO2 ") emit("", pcs[i])
        print("   pH  ") emit("", ph)
        print("   iters ") pi64(CB_ITERS) print("   charge residual ") emit("", CB_RESIDUAL)
        let c3 = co3(313.15, pcs[i], ph)
        print("   Ca  ") emit("", exp(log_k(4, 313.15) * LN10) / c3)
        println("")
        i = i + 1
    }
    println("")
    println("== ACTIVITY-AWARE closure vs the ideal one, and vs the oracle ==")
    var j: i64 = 0
    var qs: [f64; 3] = [0.0; 3]
    qs[0] = 0.01
    qs[1] = 0.1
    qs[2] = 1.0
    while j < 3 {
        let ph_a = solve_ph_activity(313.15, qs[j])
        print("P_CO2 ") emit("", qs[j])
        print("   pH_activity ") emit("", ph_a)
        print("   mu ") emit("", MU_LAST)
        print("   outer_iters ") pi64(MU_ITERS) println("")
        print("   Ca_activity ") emit("", ca_activity_model(313.15, qs[j], ph_a, MU_LAST))
        j = j + 1
    }
    println("")
    println("== WITH ION PAIRS: CaHCO3+, CaCO3(aq), CaOH+ ==")
    var w: i64 = 0
    var ps2: [f64; 3] = [0.0; 3]
    ps2[0] = 0.01
    ps2[1] = 0.1
    ps2[2] = 1.0
    while w < 3 {
        let ph_p = solve_ph_pairs(313.15, ps2[w])
        print("P_CO2 ") emit("", ps2[w])
        print("   pH ") emit("", ph_p)
        print("   mu ") emit("", SP_MU)
        print("   Ca_total ") emit("", SP_M_TOTAL_CA)
        print("   free_Ca ") emit("", SP_M_CA)
        print("   CaHCO3+ ") emit("", SP_M_CAHCO3)
        print("   CaCO3aq ") emit("", SP_M_CACO3)
        print("   CaOH+ ") emit("", SP_M_CAOH)
        w = w + 1
    }
    println("== bracketing control: an interval with no sign change must refuse ==")
    emit("solve_ph(4.0..4.5)", solve_ph(313.15, 0.01, 4.0, 4.5, 1.0e-12))
    0
}
